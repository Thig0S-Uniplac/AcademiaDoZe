<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
             xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.AlunoListPage"
             x:DataType="vm:AlunoListViewModel"
             Title="{Binding Title}">
    <ContentPage.Resources>
        <converters:FotoToImageSourceConverter x:Key="FotoToImageSourceConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="15,10">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                <Picker Grid.Column="0"
                        ItemsSource="{Binding FilterTypes}"
                        SelectedItem="{Binding SelectedFilterType}"
                        WidthRequest="90"
                        Title="Filtro" />
                <Entry Grid.Column="1"
                       Text="{Binding SearchText}"
                       Placeholder="Digite o valor..."
                       ClearButtonVisibility="WhileEditing"
                       ReturnCommand="{Binding SearchAlunosCommand}" />
                <Button Grid.Column="2"
                        Text="Buscar"
                        Command="{Binding SearchAlunosCommand}"
                        Style="{StaticResource ButtonPrimary}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
                <CollectionView ItemsSource="{Binding Alunos}" SelectionMode="None" Margin="10">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="{OnIdiom Phone=1, Tablet=2, Desktop=3, TV=4, Default=1}" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:AlunoDto">
                            <Border Style="{StaticResource CardBorder}" Margin="8">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center">
                                        <Label Text="{Binding Nome}" FontAttributes="Bold" FontSize="17" />
                                        <Label Text="{Binding Cpf, StringFormat='CPF: {0}'}" />
                                        <Label Text="{Binding Telefone, StringFormat='Telefone: {0}'}" />
                                        <Label Text="{Binding Email, StringFormat='E-mail: {0}'}" />
                                        <Label Text="{Binding DataNascimento, StringFormat='Nascimento: {0:dd/MM/yyyy}'}" />
                                        <Label LineBreakMode="WordWrap">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Endereco.Nome}" />
                                                    <Span Text=", " />
                                                    <Span Text="{Binding Numero}" />
                                                    <Span Text=" - " />
                                                    <Span Text="{Binding Endereco.Bairro}" />
                                                    <Span Text=", " />
                                                    <Span Text="{Binding Endereco.Cidade}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Image Source="{Binding Foto, Converter={StaticResource FotoToImageSourceConverter}}"
                                               Aspect="AspectFill"
                                               HeightRequest="96"
                                               WidthRequest="96"
                                               HorizontalOptions="Start" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1"
                                            Text="Editar"
                                            Style="{StaticResource ButtonSmall}"
                                            VerticalOptions="Start"
                                            Clicked="OnEditButtonClicked" />
                                    <Button Grid.Column="2"
                                            Text="Excluir"
                                            Style="{StaticResource ButtonDanger}"
                                            VerticalOptions="Start"
                                            Clicked="OnDeleteButtonClicked" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                            <Label Text="Nenhum aluno encontrado" Style="{StaticResource SubHeadline}" />
                            <Button Text="Cadastrar Primeiro Aluno"
                                    Command="{Binding AddAlunoCommand}"
                                    Style="{StaticResource ButtonPrimary}" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </RefreshView>

            <Button Text="Adicionar Aluno"
                    Command="{Binding AddAlunoCommand}"
                    Style="{StaticResource ButtonPrimary}"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="20" />
            <Grid Background="{AppThemeBinding Light=#80FFFFFF, Dark=#80000000}" IsVisible="{Binding IsBusy}">
                <ActivityIndicator IsRunning="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
