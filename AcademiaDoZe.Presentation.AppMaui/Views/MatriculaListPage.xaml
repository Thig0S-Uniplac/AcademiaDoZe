<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
             xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.MatriculaListPage"
             x:Name="MatriculasPage"
             x:DataType="vm:MatriculaListViewModel"
             Title="{Binding Title}">
    <ContentPage.Resources>
        <converters:FotoToImageSourceConverter x:Key="FotoToImageSourceConverter" />
        <converters:EnumDisplayConverter x:Key="EnumDisplay" />
        <converters:RestricoesFlagsDisplayConverter x:Key="RestricoesDisplay" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <Border Style="{StaticResource CardBorder}" Margin="15,10">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Picker ItemsSource="{Binding FilterTypes}" SelectedItem="{Binding SelectedFilterType}" WidthRequest="110" />
                <Entry Grid.Column="1" Text="{Binding SearchText}" Placeholder="Digite o valor..."
                       ClearButtonVisibility="WhileEditing" ReturnCommand="{Binding SearchMatriculasCommand}" />
                <Button Grid.Column="2" Command="{Binding SearchMatriculasCommand}" Style="{StaticResource ButtonPrimary}">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe8b6;" />
                    </Button.ImageSource>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
                <CollectionView ItemsSource="{Binding Matriculas}" SelectionMode="None" Margin="10">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical">
                            <GridItemsLayout.Span>
                                <OnIdiom x:TypeArguments="x:Int32" Phone="1" Default="1" Tablet="2" Desktop="3" TV="4" />
                            </GridItemsLayout.Span>
                        </GridItemsLayout>
                    </CollectionView.ItemsLayout>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" Spacing="20">
                            <Label Text="Nenhuma matrícula encontrada" HorizontalOptions="Center" Style="{StaticResource SubHeadline}" />
                            <Button Text="Adicionar Matrícula" Command="{Binding AddMatriculaCommand}" Style="{StaticResource ButtonPrimary}" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:MatriculaDto">
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItem Text="Editar" BackgroundColor="DodgerBlue"
                                                   Command="{Binding BindingContext.EditMatriculaCommand, Source={x:Reference MatriculasPage}}" CommandParameter="{Binding .}" />
                                        <SwipeItem Text="Excluir" BackgroundColor="Red"
                                                   Command="{Binding BindingContext.DeleteMatriculaCommand, Source={x:Reference MatriculasPage}}" CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>
                                <Border Style="{StaticResource CardBorder}" Margin="5">
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Border HeightRequest="56" WidthRequest="56" StrokeShape="RoundRectangle 8">
                                                <Image Source="{Binding AlunoMatricula.Foto, Converter={StaticResource FotoToImageSourceConverter}}" Aspect="AspectFill" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                <Label Text="{Binding AlunoMatricula.Nome}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding AlunoMatricula.Cpf, StringFormat='CPF: {0}'}" FontSize="12" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="2" Style="{StaticResource ButtonSmall}" Clicked="OnMoreClicked">
                                                <Button.ImageSource>
                                                    <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe5d4;" />
                                                </Button.ImageSource>
                                            </Button>
                                        </Grid>
                                        <Label Text="{Binding Id, StringFormat='Matrícula: {0}'}" FontSize="12" />
                                        <Label Text="{Binding Plano, Converter={StaticResource EnumDisplay}}" FontAttributes="Bold" />
                                        <Label Text="{Binding DataInicio, StringFormat='Início: {0:dd/MM/yyyy}'}" FontSize="12" />
                                        <Label Text="{Binding DataFim, StringFormat='Término: {0:dd/MM/yyyy}'}" FontSize="12" />
                                        <Label Text="{Binding Objetivo, StringFormat='Objetivo: {0}'}" LineBreakMode="TailTruncation" FontSize="12" />
                                        <Label Text="{Binding RestricoesMedicas, Converter={StaticResource RestricoesDisplay}}" LineBreakMode="WordWrap" FontSize="12" />
                                        <Label Text="{Binding ObservacoesRestricoes, StringFormat='Obs: {0}'}" LineBreakMode="TailTruncation" FontSize="12" />
                                    </VerticalStackLayout>
                                </Border>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
            <Button Command="{Binding AddMatriculaCommand}" Style="{StaticResource ButtonPrimary}"
                    WidthRequest="56" HeightRequest="56" HorizontalOptions="End" VerticalOptions="End" Margin="20">
                <Button.ImageSource>
                    <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe145;" />
                </Button.ImageSource>
            </Button>
        </Grid>
        <ActivityIndicator Grid.RowSpan="2" IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
