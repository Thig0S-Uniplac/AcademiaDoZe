<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.ConfigPage"
             Title="Configurações">

    <ScrollView>
        <StackLayout Spacing="20">

            <!-- Tema -->
            <Border Style="{StaticResource CardBorder}" Margin="15,10">
                <StackLayout Spacing="15">
                    <Label Text="Tema" Style="{StaticResource SubHeadline}" HorizontalTextAlignment="Center"/>

                    <StackLayout Spacing="5">
                        <Label Text="Tema" />
                        <Picker x:Name="TemaPicker">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>light</x:String>
                                    <x:String>dark</x:String>
                                    <x:String>system</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </StackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0" Text="Cancelar" Clicked="OnCancelarClicked" Style="{StaticResource ButtonSecondary}" HeightRequest="45">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe5c9;" Size="18" Color="{AppThemeBinding Light=#404040, Dark=#919191}" />
                            </Button.ImageSource>
                        </Button>
                        <Button Grid.Column="1" Text="Salvar Tema" Clicked="OnSalvarTemaClicked" Style="{StaticResource ButtonPrimary}" HeightRequest="45">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe161;" Size="18" Color="{AppThemeBinding Light=White, Dark=#242424}" />
                            </Button.ImageSource>
                        </Button>
                    </Grid>
                </StackLayout>
            </Border>

            <!-- Banco SQLite -->
            <Border Style="{StaticResource CardBorder}" Margin="15,10">
                <StackLayout Spacing="15">
                    <Label Text="Banco de dados" Style="{StaticResource SubHeadline}" HorizontalTextAlignment="Center"/>

                    <Border BackgroundColor="{AppThemeBinding Light=#F0F7FF, Dark=#1A2633}" StrokeShape="RoundRectangle 8" Padding="12">
                        <Label Text="O SQLite é um banco de dados local armazenado em arquivo. Não requer servidor de rede, usuário ou senha."
                               FontSize="13"
                               TextColor="{AppThemeBinding Light=#0056B3, Dark=#66B2FF}"/>
                    </Border>

                    <StackLayout Spacing="5">
                        <Label Text="Caminho / arquivo do banco (.db)"/>
                        <Entry x:Name="SqliteCaminhoEntry" Placeholder="Arquivo SQLite"/>
                    </StackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0" Text="Cancelar" Clicked="OnCancelarClicked" Style="{StaticResource ButtonSecondary}" HeightRequest="45">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe5c9;" Size="18" Color="{AppThemeBinding Light=#404040, Dark=#919191}" />
                            </Button.ImageSource>
                        </Button>
                        <Button Grid.Column="1" Text="Salvar BD" Clicked="OnSalvarBdClicked" Style="{StaticResource ButtonPrimary}" HeightRequest="45">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe161;" Size="18" Color="{AppThemeBinding Light=White, Dark=#242424}" />
                            </Button.ImageSource>
                        </Button>
                    </Grid>
                </StackLayout>
            </Border>

        </StackLayout>
    </ScrollView>
</ContentPage>
